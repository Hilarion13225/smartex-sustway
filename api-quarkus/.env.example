# =====================================================================
# Copiez ce fichier en ".env" (à la racine de api-quarkus/, à côté de
# pom.xml) et remplissez avec vos vraies valeurs. ".env" est déjà exclu
# du dépôt via .gitignore — ne JAMAIS committer de vrais identifiants.
#
# Quarkus charge automatiquement un fichier .env présent dans le
# répertoire courant, sans configuration supplémentaire.
# =====================================================================

# --- Brevo (email de vérification de compte, RG36) ---
# 1. Créez un compte gratuit sur https://www.brevo.com (300 emails/jour, gratuit à vie)
# 2. Ajoutez et vérifiez un expéditeur : Menu → Expéditeurs, domaines & IP dédiées
#    → Expéditeurs → Ajouter un expéditeur (une simple adresse email suffit,
#    pas besoin d'un nom de domaine pour commencer)
# 3. Récupérez vos identifiants SMTP : Menu → SMTP & API → onglet SMTP
#    (génère un "SMTP login" et une "master password" si pas déjà fait —
#    ce ne sont PAS vos identifiants de connexion au tableau de bord Brevo)
SMARTEX_MAIL_HOST=smtp-relay.brevo.com
SMARTEX_MAIL_PORT=587
SMARTEX_MAIL_USERNAME=votre-login-smtp@smtp-brevo.com
SMARTEX_MAIL_PASSWORD=votre-master-password-smtp
SMARTEX_MAIL_FROM=votre-expediteur-verifie@example.com

# URL publique de l'API (utilisée pour construire le lien dans l'email de
# vérification) — laissez la valeur par défaut en développement local.
SMARTEX_API_BASE_URL=http://localhost:8080
